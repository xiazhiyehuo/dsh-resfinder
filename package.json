{
  "name": "dsh-resfinder",
  "version": "0.1.0",
  "description": "判断链接能不能用、什么时候会坏掉：核验落地域名与证书、给官方下载渠道、巡检失效链接。DSH 插件 + CLI + MCP。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./ui": "./lib/ui.js",
    "./lib/search": "./lib/search.js",
    "./lib/sites": "./lib/sites.js",
    "./lib/verify": "./lib/verify.js",
    "./lib/channels": "./lib/channels.js",
    "./lib/store": "./lib/store.js",
    "./lib/tools": "./lib/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "resfinder": "./bin/resfinder.js",
    "resfinder-mcp": "./mcp/server.js"
  },
  "files": [
    "lib",
    "bin",
    "mcp",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node ./scripts/smoke.mjs",
    "mcp": "node ./mcp/server.js"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "link-verification",
    "url-check",
    "official-source",
    "mcp",
    "security"
  ],
  "license": "MIT",
  "author": "xiazhijiehuo",
  "repository": {
    "type": "git",
    "url": "git@github.com:xiazhijiehuo/dsh-resfinder.git"
  },
  "bugs": {
    "url": "https://github.com/xiazhijiehuo/dsh-resfinder/issues"
  },
  "homepage": "https://github.com/xiazhijiehuo/dsh-resfinder#readme"
}
